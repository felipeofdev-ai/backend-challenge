{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Wager processed rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(wager_processed_total[1m])) by (kind, status)",
          "legendFormat": "{{kind}} {{status}}"
        }
      ]
    },
    {
      "title": "Outbox lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "outbox_lag_messages",
          "legendFormat": "unpublished"
        }
      ]
    },
    {
      "title": "SQS DLQ depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sqs_dlq_depth",
          "legendFormat": "dlq"
        }
      ]
    },
    {
      "title": "Wager latency p95 (histogram)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(wager_duration_seconds_bucket[5m])) by (le, kind))",
          "legendFormat": "{{kind}} p95"
        }
      ]
    },
    {
      "title": "Dependency probe failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(dependency_probe_failures_total[1m])) by (dependency)",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "title": "SLO under 250ms ratio",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "wager_slo_latency_under_250ms_ratio",
          "legendFormat": "ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["wagering", "jungle"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Wagering Processor",
  "uid": "wagering-processor",
  "version": 1
}
