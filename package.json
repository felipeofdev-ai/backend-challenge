{
  "name": "wagering-processor",
  "version": "1.0.0",
  "description": "Distributed wagering processor — Jungle Gaming technical challenge",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "bun run nest build",
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "worker": "bun run src/worker.ts",
    "migration:up": "bun run scripts/migrate.ts",
    "migration:down": "bun run scripts/migrate-down.ts",
    "migration:pending": "bunx mikro-orm migration:pending --config ./mikro-orm.config.ts",
    "migration:create": "bunx mikro-orm migration:create --config ./mikro-orm.config.ts",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:concurrency": "bun test tests/concurrency",
    "test:concurrency:harness": "bun run scripts/concurrency-harness.ts",
    "test:forensic": "bun test tests/forensic",
    "test:chaos": "bun test tests/chaos",
    "test:load": "bun test tests/load",
    "test:load:harness": "bun run scripts/load-harness.ts",
    "report:system": "bun run scripts/system-report.ts",
    "test:all": "bun test tests/unit && bun test tests/forensic && bun test tests/concurrency && bun test tests/integration && bun test tests/load && bun test tests/chaos",
    "lint": "bunx @biomejs/biome check src tests",
    "lint:fix": "bunx @biomejs/biome check --write src tests",
    "typecheck": "bunx tsc --noEmit",
    "docker:app": "docker compose --profile app up -d --build",
    "docker:multi": "docker compose --profile multi-instance up -d --build",
    "docker:auth": "docker compose --profile auth up -d",
    "docker:chaos": "docker compose --profile chaos up -d",
    "docker:obs": "docker compose --profile obs up -d"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.758.0",
    "@mikro-orm/core": "^6.4.11",
    "@mikro-orm/migrations": "^6.4.11",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.11",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/swagger": "11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "decimal.js": "^10.5.0",
    "jose": "^6.2.10",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@mikro-orm/cli": "^6.4.11",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "bun-types": "^1.4.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "mikro-orm": {
    "useTsNode": false,
    "configPaths": [
      "./mikro-orm.config.ts",
      "./src/infrastructure/orm/mikro-orm.config.ts"
    ]
  }
}
