# Application
NODE_ENV=development
PORT=3000
APP_NAME=wagering-processor
AUTH_MODE=static
ALLOW_ANONYMOUS=true
# AUTH_MODE=oidc requires Keycloak (docker compose --profile auth up -d)
# KEYCLOAK_ISSUER=http://localhost:8080/realms/jungle-gaming
# KEYCLOAK_AUDIENCE=wagering-api
# KEYCLOAK_JWKS_URI=http://localhost:8080/realms/jungle-gaming/protocol/openid-connect/certs
# postgres (default) | memory
PERSISTENCE=postgres

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=wagering
DATABASE_PASSWORD=wagering
DATABASE_NAME=wagering
DATABASE_SSL=false

# AWS / LocalStack SQS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_EVENTS_DLQ_URL=http://localhost:4566/000000000000/wager-events-dlq.fifo

# Workers
OUTBOX_POLL_INTERVAL_MS=1000
REFERENCE_POLL_INTERVAL_MS=15000
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_TTL_HOURS=24
LOCK_TIMEOUT_MS=2000
LOCK_RETRY_MAX=3

# Observability
LOG_LEVEL=info
METRICS_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=wagering-processor

# HTTP path: sync (challenge default) | enqueue (opt-in 202 → SQS)
WAGER_HTTP_MODE=sync
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_POOL_ACQUIRE_MS=5000
IN_FLIGHT_VISIBILITY_SECONDS=5

# Crash/fault injection (tests only — never enable in production)
SLOW_ACK_MS=0
CRASH_AFTER_COMMIT=false
